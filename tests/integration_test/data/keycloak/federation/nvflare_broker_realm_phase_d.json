{
  "realm": "nvflare-broker",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "nvflare-admin",
      "name": "NVFlare Admin Broker Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "nvflare-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "oauth2.token.exchange.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "org",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "org",
            "jsonType.label": "String"
          }
        },
        {
          "name": "nvf_role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "nvf_role",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "nvf_role",
            "jsonType.label": "String"
          }
        },
        {
          "name": "nvflare-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "nvflare-admin",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "idp-org-a",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "http://127.0.0.1:8080/realms/org-a-idp",
        "authorizationUrl": "http://127.0.0.1:8080/realms/org-a-idp/protocol/openid-connect/auth",
        "tokenUrl": "http://127.0.0.1:8080/realms/org-a-idp/protocol/openid-connect/token",
        "jwksUrl": "http://127.0.0.1:8080/realms/org-a-idp/protocol/openid-connect/certs",
        "userInfoUrl": "http://127.0.0.1:8080/realms/org-a-idp/protocol/openid-connect/userinfo",
        "logoutUrl": "http://127.0.0.1:8080/realms/org-a-idp/protocol/openid-connect/logout",
        "clientId": "broker-org-a",
        "clientSecret": "broker-secret-a",
        "backchannelSupported": "false",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "defaultScope": "openid profile email"
      }
    },
    {
      "alias": "idp-org-b",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "issuer": "http://127.0.0.1:8080/realms/org-b-idp",
        "authorizationUrl": "http://127.0.0.1:8080/realms/org-b-idp/protocol/openid-connect/auth",
        "tokenUrl": "http://127.0.0.1:8080/realms/org-b-idp/protocol/openid-connect/token",
        "jwksUrl": "http://127.0.0.1:8080/realms/org-b-idp/protocol/openid-connect/certs",
        "userInfoUrl": "http://127.0.0.1:8080/realms/org-b-idp/protocol/openid-connect/userinfo",
        "logoutUrl": "http://127.0.0.1:8080/realms/org-b-idp/protocol/openid-connect/logout",
        "clientId": "broker-org-b",
        "clientSecret": "broker-secret-b",
        "backchannelSupported": "false",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "disableUserInfo": "false",
        "defaultScope": "openid profile email"
      }
    }
  ],
  "users": [
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "alice-broker",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Broker",
      "email": "alice@orga.com",
      "emailVerified": true,
      "requiredActions": [],
